# Variables obligatorias del API Gateway (docker run --env-file .env ...)
# En AWS se inyectan desde Secrets Manager / Parameter Store, nunca en la imagen.

# Mismo secreto con el que firma el módulo de Autenticación (mínimo 32 caracteres)
JWT_SECRET=cambia_esta_clave_por_una_de_al_menos_32_caracteres

# Origen del frontend permitido por CORS (obligatorio). Sin "/" final; varios separados por coma.
# Local: http://localhost:4200 | Producción: https://<dominio-del-frontend>
FRONTEND_URL=http://localhost:4200

# URLs de los microservicios (desde un contenedor local, usar host.docker.internal)
ESTUDIANTES_URL=http://host.docker.internal:3001
MATERIAS_URL=http://host.docker.internal:3002
INSCRIPCIONES_URL=http://host.docker.internal:3003
AUTENTICACION_URL=http://host.docker.internal:3004
